    /**
     * The constructor.
     * @param memory the memory context which will be used to read instructions
     */
    public %decoder_class%(MemoryContext<? extends Number> memory) {
        this.memory = Objects.requireNonNull(memory);
    }

    /**
     * Decodes an instruction.
     * Results are cached by memory position. On cache hit the raw
     * instruction bytes are re-read and compared with the stored
     * ones so that self-modifying code is detected automatically
     * without any external listener or manual invalidation.
     * @param memoryPosition the address of the start of the instruction
     * @return the decoded instruction object
     * @throws InvalidInstructionException when decoding is not successful
     */
    @Override
    public DecodedInstruction decode(int memoryPosition) throws InvalidInstructionException {
        this.memoryPosition = memoryPosition;
        this.loadedInstructionBytes = 0;

        FastDecodedInstruction entry = cache.get(memoryPosition);
        if (entry != null) {
            byte[] cachedBytes = entry.getImage();
            Number[] currentBytes = memory.read(memoryPosition, cachedBytes.length);
            if (matchesCachedBytes(cachedBytes, currentBytes)) {
                return entry;
            }
            copyBytes(currentBytes, 0);
            loadedInstructionBytes = currentBytes.length;
        }

        instruction = new FastDecodedInstruction();
        bitsRead = 0;
        %root_rule%;

        int imageLength = Math.max(1, (bitsRead + 7) >>> 3);
        byte[] image = Arrays.copyOf(instructionBytes, imageLength);
        instruction.setImage(image);
        cache.put(memoryPosition, instruction);
        return instruction;
    }

    private boolean matchesCachedBytes(byte[] cachedBytes, Number[] currentBytes) {
        if (currentBytes.length != cachedBytes.length) {
            return false;
        }
        for (int i = 0; i < cachedBytes.length; i++) {
            if (cachedBytes[i] != currentBytes[i].byteValue()) {
                return false;
            }
        }
        return true;
    }

    private void ensureInstructionCapacity(int requiredBytes) {
        if (instructionBytes.length >= requiredBytes) {
            return;
        }

        int newLength = instructionBytes.length;
        while (newLength < requiredBytes) {
            newLength <<= 1;
        }
        instructionBytes = Arrays.copyOf(instructionBytes, newLength);
    }

    private void copyBytes(Number[] bytes, int destinationOffset) {
        ensureInstructionCapacity(destinationOffset + bytes.length);
        for (int i = 0; i < bytes.length; i++) {
            instructionBytes[destinationOffset + i] = bytes[i].byteValue();
        }
    }

    private void ensureInstructionBytesLength(int bitLength) {
        int requiredBytes = Math.max(1, (bitLength + 7) >>> 3);
        if (loadedInstructionBytes < requiredBytes) {
            Number[] missingBytes = memory.read(
                    memoryPosition + loadedInstructionBytes,
                    requiredBytes - loadedInstructionBytes
            );
            copyBytes(missingBytes, loadedInstructionBytes);
            loadedInstructionBytes = requiredBytes;
        }
    }

    /**
     * Reads an arbitrary number of bits of the current instruction.
     * Bits are read in little endian
     *
     * @param start the number of bits from the start of the current instruction
     * @param length the number of bits to read
     * @return the bytes read
     */
    private int readBits(int start, int length) {
        if (length == 0) {
            return 0;
        }

        int end = start + length;
        if (bitsRead < end) {
            bitsRead = end;
        }
        ensureInstructionBytesLength(end);

        int startByte = start >>> 3;
        int endByte = (end + 7) >>> 3;
        long value = 0;

        for (int i = startByte; i < endByte; i++) {
            value = (value << 8) | (instructionBytes[i] & 0xFFL);
        }

        int shift = ((endByte - startByte) << 3) - (start & 0x7) - length;
        long mask = (length == 32) ? UNSIGNED_INT_MASK : ((1L << length) - 1L);
        return (int) ((value >>> shift) & mask);
    }

