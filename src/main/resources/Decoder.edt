%auto_gen_warning%
package %decoder_package%;

import net.emustudio.emulib.plugin.cpu.DecodedInstruction;
import net.emustudio.emulib.plugin.cpu.Decoder;
import net.emustudio.emulib.plugin.cpu.InvalidInstructionException;
import net.emustudio.emulib.plugin.memory.MemoryContext;
import net.emustudio.emulib.Bits;

import java.util.*;
import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.util.function.UnaryOperator;

/**
 * The instruction decoder.
 */
public class %decoder_class% implements Decoder {
    private static final int CACHE_CAPACITY = 256;
    private static final int INITIAL_BUFFER_SIZE = 8;
    private static final long UNSIGNED_INT_MASK = 0xFFFFFFFFL;

    // A rule key can carry the original string returned by a named variant.
    private static final byte HAS_STRING = 2;

    // A rule key can carry raw operand bits returned by a subrule.
    private static final byte HAS_BITS = 4;

    // Keep the default footprint small; sparse or high rule codes grow on demand.
    private static final int INITIAL_KEY_CAPACITY = 8;


    private byte[] instructionBytes = new byte[INITIAL_BUFFER_SIZE];
    private final MemoryContext<? extends Number> memory;

    private int memoryPosition;
    private int loadedInstructionBytes;
    private int unit;
    private int bitsRead;

    private byte[] keyStates = new byte[INITIAL_KEY_CAPACITY];
    private String[] strings = new String[INITIAL_KEY_CAPACITY];
    private int[] bitValues = new int[INITIAL_KEY_CAPACITY];
    private int[] bitLengths = new int[INITIAL_KEY_CAPACITY];

    private int keyCount;

    private static final class Cached {
        final byte[] image;
        final DecodedInstruction instruction;
        Cached(byte[] image, DecodedInstruction instruction) {
            this.image = image;
            this.instruction = instruction;
        }
    }

    /**
     * LRU cache of decoded instructions keyed by memory position.
     * Evicts least-recently-used entries when capacity is exceeded.
     */
    private final Map<Integer, Cached> cache = new LinkedHashMap<Integer, Cached>(
            CACHE_CAPACITY + 1, 0.75f, true
    ) {
        @Override
        protected boolean removeEldestEntry(Map.Entry<Integer, Cached> eldest) {
            return size() > CACHE_CAPACITY;
        }
    };

    %decoder_fields%

    /**
     * The constructor.
     * @param memory the memory context which will be used to read instructions
     */
    public %decoder_class%(MemoryContext<? extends Number> memory) {
        this.memory = Objects.requireNonNull(memory);
        if (memory.getCellTypeClass() != Byte.class)
            throw new IllegalArgumentException("Generated decoder requires byte memory");
    }

    /**
     * Decodes an instruction.
     * Results are cached by memory position. On cache hit the raw
     * instruction bytes are re-read and compared with the stored
     * ones so that self-modifying code is detected automatically
     * without any external listener or manual invalidation.
     * @param memoryPosition the address of the start of the instruction
     * @return the decoded instruction object
     * @throws InvalidInstructionException when decoding is not successful
     */
    @Override
    public synchronized DecodedInstruction decode(int memoryPosition) throws InvalidInstructionException {
        if (memoryPosition < 0 || memoryPosition >= memory.getSize())
            throw new IndexOutOfBoundsException("Instruction address outside memory");
        this.memoryPosition = memoryPosition;
        this.loadedInstructionBytes = 0;

        Cached entry = cache.get(memoryPosition);
        if (entry != null) {
            byte[] cachedBytes = entry.image;
            Number[] currentBytes = readMemory(memoryPosition, cachedBytes.length);
            if (matchesCachedBytes(cachedBytes, currentBytes)) {
                return entry.instruction;
            }
            copyBytes(currentBytes, 0);
            loadedInstructionBytes = currentBytes.length;
        }

        reset();
        %root_rule%;

        int imageLength = Math.max(1, (bitsRead + 7) >>> 3);
        byte[] image = Arrays.copyOf(instructionBytes, imageLength);

        Bits[] bits = new Bits[keyStates.length];
        for (int key = 0; key < keyStates.length; key++) {
            if ((keyStates[key] & HAS_BITS) != 0) bits[key] = new Bits(bitValues[key], bitLengths[key]);
        }
        DecodedInstruction instruction = DecodedInstruction.of(memoryPosition, imageLength,
                Rendering.mnemonic(keyCount, strings, bits), Rendering.formatImage(image));

        cache.put(memoryPosition, new Cached(image, instruction));
        return instruction;
    }

    private Number[] readMemory(int address, int count) {
        if (count < 0 || count > memory.getSize())
            throw new IndexOutOfBoundsException("Instruction exceeds address space");
        Number[] cells = memory.read(address, count);
        if (cells.length != count) throw new IndexOutOfBoundsException("Incomplete instruction input");
        return cells;
    }

    private boolean matchesCachedBytes(byte[] cachedBytes, Number[] currentBytes) {
        if (currentBytes.length != cachedBytes.length) {
            return false;
        }
        for (int i = 0; i < cachedBytes.length; i++) {
            if (cachedBytes[i] != currentBytes[i].byteValue()) {
                return false;
            }
        }
        return true;
    }

    private void ensureInstructionCapacity(int requiredBytes) {
        if (instructionBytes.length >= requiredBytes) {
            return;
        }

        int newLength = instructionBytes.length;
        while (newLength < requiredBytes) {
            newLength <<= 1;
        }
        instructionBytes = Arrays.copyOf(instructionBytes, newLength);
    }

    private void copyBytes(Number[] bytes, int destinationOffset) {
        ensureInstructionCapacity(destinationOffset + bytes.length);
        for (int i = 0; i < bytes.length; i++) {
            instructionBytes[destinationOffset + i] = bytes[i].byteValue();
        }
    }

    private void ensureInstructionBytesLength(int bitLength) {
        int requiredBytes = Math.max(1, (bitLength + 7) >>> 3);
        if (loadedInstructionBytes < requiredBytes) {
            Number[] missingBytes = readMemory(
                    Math.addExact(memoryPosition, loadedInstructionBytes),
                    requiredBytes - loadedInstructionBytes
            );
            copyBytes(missingBytes, loadedInstructionBytes);
            loadedInstructionBytes = requiredBytes;
        }
    }

    /**
     * Reads an arbitrary number of bits of the current instruction.
     * Bits are read in little endian
     *
     * @param start the number of bits from the start of the current instruction
     * @param length the number of bits to read
     * @return the bytes read
     */
    private int readBits(int start, int length) {
        if (length == 0) {
            return 0;
        }

        int end = start + length;
        if (bitsRead < end) {
            bitsRead = end;
        }
        ensureInstructionBytesLength(end);

        int startByte = start >>> 3;
        int endByte = (end + 7) >>> 3;
        long value = 0;

        for (int i = startByte; i < endByte; i++) {
            value = (value << 8) | (instructionBytes[i] & 0xFFL);
        }

        int shift = ((endByte - startByte) << 3) - (start & 0x7) - length;
        long mask = (length == 32) ? UNSIGNED_INT_MASK : ((1L << length) - 1L);
        return (int) ((value >>> shift) & mask);
    }

    /**
     * Resets the decoder state for a new instruction.
     */
    private void reset() {
        bitsRead = 0;
        keyStates = new byte[INITIAL_KEY_CAPACITY];
        strings = new String[INITIAL_KEY_CAPACITY];
        bitValues = new int[INITIAL_KEY_CAPACITY];
        bitLengths = new int[INITIAL_KEY_CAPACITY];
        keyCount = 0;
    }

    /**
     * Adds instruction: string-returning variant
     *
     * @param key      the key (rule code)
     * @param string   the string which the recognized variant returned
     */
    private void addInstruction(int key, String string) {
        prepareKey(key);
        keyStates[key] |= HAS_STRING;
        strings[key] = string;
    }

    /**
     * Adds instruction: subrule-returning variant
     *
     * @param key    the rule code
     * @param bits   the bit sequence in little-endian, padded to whole bytes
     * @param length bit length (in bits)
     */
    private void addInstruction(int key, int bits, int length) {
        prepareKey(key);
        keyStates[key] |= HAS_BITS;
        bitValues[key] = bits;
        bitLengths[key] = length;
    }

    private void prepareKey(int key) {
        ensureKeyCapacity(key);
        if (keyStates[key] == 0) {
            keyCount++;
        }
    }

    private void ensureKeyCapacity(int key) {
        if (key < keyStates.length) {
            return;
        }

        int newLength = keyStates.length;
        while (newLength <= key) {
            newLength <<= 1;
        }

        keyStates = Arrays.copyOf(keyStates, newLength);
        strings = Arrays.copyOf(strings, newLength);
        bitValues = Arrays.copyOf(bitValues, newLength);
        bitLengths = Arrays.copyOf(bitLengths, newLength);
    }

    %decoder_methods%

    private static final class Rendering {
        private static final char[] HEX_DIGITS = "0123456789ABCDEF".toCharArray();

        /**
        * An instruction mnemonic format string with associated parameters.
        */
        private static class MnemonicFormat {
            private final String format;
            private final Parameter[] parameters;

            public MnemonicFormat(String format, Parameter[] parameters) {
                this.format = format;
                this.parameters = parameters;
            }

            public String getFormat() { return format; }
            public Parameter[] getParameters() { return parameters; }
        }

        /**
        * A parameter of a format (a rule and a constant-decoding strategy).
        */
        private static class Parameter {
            private final int ruleCode;
            private final BitOperations bitOperations;

            public Parameter(int ruleCode, BitOperations bitOperations) {
                this.ruleCode = ruleCode;
                this.bitOperations = bitOperations;
            }

            public int getRuleCode() { return ruleCode; }
            public BitOperations getBitOperations() { return bitOperations; }
        }

        /**
        * An ordered pipeline of {@link Bits} transformations applied to a decoded parameter.
        */
        private static final class BitOperations {
            private final List<UnaryOperator<Bits>> operations = new ArrayList<>();

            static BitOperations builder() { return new BitOperations(); }

            Bits apply(Bits bits) {
                Bits result = bits;
                for (UnaryOperator<Bits> operation : operations) {
                    result = operation.apply(result);
                }
                return result;
            }

            private BitOperations then(UnaryOperator<Bits> operation) { operations.add(operation); return this; }
            BitOperations reverseBytes() { return then(Bits::reverseBytes); }
            BitOperations reverseBits() { return then(Bits::reverseBits); }
            BitOperations absolute() { return then(Bits::absolute); }
            BitOperations shiftLeft() { return then(Bits::shiftLeft); }
            BitOperations shiftRight() { return then(Bits::shiftRight); }
        }

        private static final Map<Set<Integer>, MnemonicFormat> formatMap;

        static {
            String[] formats = {
              %disasm_formats%
            };

            Parameter[][] parameters = {
                %disasm_parameters%
            };

            formatMap = new HashMap<>();

            for (int i = 0; i < formats.length; i++) {
                Set<Integer> ruleCodes = new HashSet<>();

                for (Parameter parameter : parameters[i]) {
                    ruleCodes.add(parameter.getRuleCode());
                }

                formatMap.put(ruleCodes, new MnemonicFormat(formats[i], parameters[i]));
            }
        }

        static String mnemonic(int keyCount, String[] strings, Bits[] bits) {
            Set<Integer> keys = new HashSet<>(Math.max(1, keyCount));
            for (int ruleCode = 0; ruleCode < strings.length && keys.size() < keyCount; ruleCode++) {
                if (strings[ruleCode] != null || bits[ruleCode] != null) {
                    keys.add(ruleCode);
                }
            }

            MnemonicFormat format = formatMap.get(keys);
            return format == null ? "N/A" : createMnemonic(strings, bits, format);
        }

        /**
         * Returns the instruction mnemonic.
         * @param instruction the decoded instruction
         * @param format the formatting string + rule codes
         * @return the instruction mnemonic
         */
        private static String createMnemonic(String[] strings, Bits[] bits, MnemonicFormat format) {
            StringBuilder mnemonic = new StringBuilder(format.getFormat());
            int position = 0;

            for (Parameter parameter : format.getParameters()) {
                position = mnemonic.indexOf("%", position);
                if (position == -1 || position == mnemonic.length()) {
                    break;
                }

                String replaced;
                Bits value = bits[parameter.getRuleCode()];
                if (value != null) {
                    value = parameter.getBitOperations().apply(value);
                    replaced = formatValue(mnemonic.charAt(position + 1), value);
                } else {
                    replaced = strings[parameter.getRuleCode()];
                }

                mnemonic.replace(position, position + 2, replaced);
            }

            return mnemonic.toString();
        }

        static String formatImage(byte[] image) {
            if (image.length == 0) {
                return "";
            }

            char[] formatted = new char[(image.length * 3) - 1];
            int out = 0;

            for (int i = 0; i < image.length; i++) {
                int value = image[i] & 0xFF;
                formatted[out++] = HEX_DIGITS[value >>> 4];
                formatted[out++] = HEX_DIGITS[value & 0x0F];
                if (i + 1 < image.length) {
                    formatted[out++] = ' ';
                }
            }

            return new String(formatted);
        }

        /**
         * Transforms bits into a string using the mnemonic formatting character.
         * <p>
         * Note: {@link Bits} carries at most 32 bits of numeric data. When formatting a 64-bit float
         * ('f' with length 64), only the low 32 bits are available.
         *
         * @param format the formatting character ('s' for a string, etc.)
         * @param bits   the bits to format
         * @return the resulting string
         */
        private static String formatValue(char format, Bits bits) {
            switch (format) {
                case 'c':
                    String string = new String(bits.toBytes());
                    return (!string.isEmpty()) ? string.substring(0, 1) : "?";
                case 'd':
                    return Integer.toString(bits.number);
                case 'f':
                    switch (bits.length) {
                        case 32:
                            return Float.toString(ByteBuffer.wrap(bits.toBytes()).order(ByteOrder.LITTLE_ENDIAN).getFloat());
                        case 64:
                            ByteBuffer buffer = ByteBuffer.allocate(8).order(ByteOrder.LITTLE_ENDIAN);
                            buffer.put(bits.toBytes());
                            buffer.position(0);
                            return Double.toString(buffer.getDouble());
                        default:
                            return "NaN";
                    }
                case 's':
                    return new String(bits.toBytes()).replace("\0", "");
                case 'x':
                    return Integer.toHexString(bits.number);
                case 'X':
                    return Integer.toHexString(bits.number).toUpperCase(Locale.ROOT);
                case '%':
                    return "%";
                default:
                    return Character.toString(format);
            }
        }
    }
}
