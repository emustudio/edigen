private static final class Rendering {
    private static final char[] HEX_DIGITS = "0123456789ABCDEF".toCharArray();

    /**
    * An instruction mnemonic format string with associated parameters.
    */
    private static class MnemonicFormat {
        private final String format;
        private final Parameter[] parameters;

        public MnemonicFormat(String format, Parameter[] parameters) {
            this.format = format;
            this.parameters = parameters;
        }

        public String getFormat() { return format; }
        public Parameter[] getParameters() { return parameters; }
    }

    /**
    * A parameter of a format (a rule and a constant-decoding strategy).
    */
    private static class Parameter {
        private final int ruleCode;
        private final BitOperations bitOperations;

        public Parameter(int ruleCode, BitOperations bitOperations) {
            this.ruleCode = ruleCode;
            this.bitOperations = bitOperations;
        }

        public int getRuleCode() { return ruleCode; }
        public BitOperations getBitOperations() { return bitOperations; }
    }

    /**
    * An ordered pipeline of {@link Bits} transformations applied to a decoded parameter.
    */
    private static final class BitOperations {
        private final List<UnaryOperator<Bits>> operations = new ArrayList<>();

        static BitOperations builder() { return new BitOperations(); }

        Bits apply(Bits bits) {
            Bits result = bits;
            for (UnaryOperator<Bits> operation : operations) {
                result = operation.apply(result);
            }
            return result;
        }

        private BitOperations then(UnaryOperator<Bits> operation) { operations.add(operation); return this; }
        BitOperations reverseBytes() { return then(Bits::reverseBytes); }
        BitOperations reverseBits() { return then(Bits::reverseBits); }
        BitOperations absolute() { return then(Bits::absolute); }
        BitOperations shiftLeft() { return then(Bits::shiftLeft); }
        BitOperations shiftRight() { return then(Bits::shiftRight); }
    }

    private static final Map<Set<Integer>, MnemonicFormat> formatMap;

    static {
        String[] formats = {
          %disasm_formats%
        };

        Parameter[][] parameters = {
            %disasm_parameters%
        };

        formatMap = new HashMap<>();

        for (int i = 0; i < formats.length; i++) {
            Set<Integer> ruleCodes = new HashSet<>();

            for (Parameter parameter : parameters[i]) {
                ruleCodes.add(parameter.getRuleCode());
            }

            formatMap.put(ruleCodes, new MnemonicFormat(formats[i], parameters[i]));
        }
    }

    static String mnemonic(int keyCount, String[] strings, Bits[] bits) {
        Set<Integer> keys = new HashSet<>(Math.max(1, keyCount));
        for (int ruleCode = 0; ruleCode < strings.length && keys.size() < keyCount; ruleCode++) {
            if (strings[ruleCode] != null || bits[ruleCode] != null) {
                keys.add(ruleCode);
            }
        }

        MnemonicFormat format = formatMap.get(keys);
        return format == null ? "N/A" : createMnemonic(strings, bits, format);
    }

    /**
     * Returns the instruction mnemonic.
     * @param instruction the decoded instruction
     * @param format the formatting string + rule codes
     * @return the instruction mnemonic
     */
    private static String createMnemonic(String[] strings, Bits[] bits, MnemonicFormat format) {
        StringBuilder mnemonic = new StringBuilder(format.getFormat());
        int position = 0;

        for (Parameter parameter : format.getParameters()) {
            position = mnemonic.indexOf("%", position);
            if (position == -1 || position == mnemonic.length()) {
                break;
            }

            String replaced;
            Bits value = bits[parameter.getRuleCode()];
            if (value != null) {
                value = parameter.getBitOperations().apply(value);
                replaced = formatValue(mnemonic.charAt(position + 1), value);
            } else {
                replaced = strings[parameter.getRuleCode()];
            }

            mnemonic.replace(position, position + 2, replaced);
        }

        return mnemonic.toString();
    }

    static String formatImage(byte[] image) {
        if (image.length == 0) {
            return "";
        }

        char[] formatted = new char[(image.length * 3) - 1];
        int out = 0;

        for (int i = 0; i < image.length; i++) {
            int value = image[i] & 0xFF;
            formatted[out++] = HEX_DIGITS[value >>> 4];
            formatted[out++] = HEX_DIGITS[value & 0x0F];
            if (i + 1 < image.length) {
                formatted[out++] = ' ';
            }
        }

        return new String(formatted);
    }

    /**
     * Transforms bits into a string using the mnemonic formatting character.
     * <p>
     * Note: {@link Bits} carries at most 32 bits of numeric data. When formatting a 64-bit float
     * ('f' with length 64), only the low 32 bits are available.
     *
     * @param format the formatting character ('s' for a string, etc.)
     * @param bits   the bits to format
     * @return the resulting string
     */
    private static String formatValue(char format, Bits bits) {
        switch (format) {
            case 'c':
                String string = new String(bits.toBytes());
                return (!string.isEmpty()) ? string.substring(0, 1) : "?";
            case 'd':
                return Integer.toString(bits.number);
            case 'f':
                switch (bits.length) {
                    case 32:
                        return Float.toString(ByteBuffer.wrap(bits.toBytes()).order(ByteOrder.LITTLE_ENDIAN).getFloat());
                    case 64:
                        ByteBuffer buffer = ByteBuffer.allocate(8).order(ByteOrder.LITTLE_ENDIAN);
                        buffer.put(bits.toBytes());
                        buffer.position(0);
                        return Double.toString(buffer.getDouble());
                    default:
                        return "NaN";
                }
            case 's':
                return new String(bits.toBytes()).replace("\0", "");
            case 'x':
                return Integer.toHexString(bits.number);
            case 'X':
                return Integer.toHexString(bits.number).toUpperCase(Locale.ROOT);
            case '%':
                return "%";
            default:
                return Character.toString(format);
        }
    }
}
